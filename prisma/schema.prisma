generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WAITER
  KITCHEN
  CASHIER
  OWNER
  ADMIN
}

enum ProductType {
  FOOD
  DRINK
  OTHER
}

enum DiningTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum OrderStatus {
  OPEN
  IN_PREPARATION
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(80)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(120)
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  ordersCreated     Order[]       @relation("OrderCreatedBy")
  ordersServed      Order[]       @relation("OrderServedBy")
  orderItemsAdded   OrderItem[]   @relation("OrderItemAddedBy")
  payments          Payment[]
  kitchenEvents     KitchenEvent[]
  reports           DailyReport[]
  openedSessions    CashierSession[] @relation("SessionOpenedBy")
  closedSessions    CashierSession[] @relation("SessionClosedBy")

  @@map("users")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  categoryId  String      @map("category_id") @db.Uuid
  name        String      @db.VarChar(120)
  type        ProductType
  price       Decimal     @db.Decimal(12, 2)
  isActive    Boolean     @default(true) @map("is_active")
  kitchenNote String?     @map("kitchen_note") @db.VarChar(255)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  portions   ProductPortion[]

  @@index([categoryId, isActive])
  @@index([type, isActive])
  @@map("products")
}

model ProductPortion {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  portion   String  @db.VarChar(50)
  price     Decimal @db.Decimal(12, 2)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, portion])
  @@map("product_portions")
}

model DiningTable {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique @db.VarChar(40)
  capacity  Int?
  status    DiningTableStatus  @default(AVAILABLE)
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("dining_tables")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  tableId         String?     @map("table_id") @db.Uuid
  orderNumber     Int         @unique @default(autoincrement()) @map("order_number")
  status          OrderStatus @default(OPEN)
  orderType       OrderType   @default(DINE_IN) @map("order_type")
  note            String?     @db.VarChar(500)
  subtotal        Decimal     @db.Decimal(12, 2)
  complimentaryTotal Decimal  @default(0) @map("complimentary_total") @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  discountReason  String?     @map("discount_reason") @db.VarChar(255)
  total           Decimal     @db.Decimal(12, 2)
  openedAt        DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt        DateTime?   @map("closed_at") @db.Timestamptz(3)
  createdById     String      @map("created_by_id") @db.Uuid
  servedById      String?     @map("served_by_id") @db.Uuid

  table       DiningTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  servedBy    User?        @relation("OrderServedBy", fields: [servedById], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payments    Payment[]
  kitchenEvents KitchenEvent[]

  @@index([tableId, status])
  @@index([status, openedAt])
  @@index([closedAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  addedById        String          @map("added_by_id") @db.Uuid
  quantity         Decimal         @db.Decimal(10, 3)
  portion          String          @default("TAM") @db.VarChar(50)
  unitPrice        Decimal         @map("unit_price") @db.Decimal(12, 2)
  lineTotal        Decimal         @map("line_total") @db.Decimal(12, 2)
  status           OrderItemStatus @default(PENDING)
  isComplimentary  Boolean         @default(false) @map("is_complimentary")
  complimentaryReason String?      @map("complimentary_reason") @db.VarChar(255)
  note             String?         @db.VarChar(500)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  addedBy User    @relation("OrderItemAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  kitchenEvents KitchenEvent[]

  @@index([orderId, status])
  @@index([productId, createdAt])
  @@index([isComplimentary, createdAt])
  @@map("order_items")
}

model KitchenEvent {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  orderItemId String          @map("order_item_id") @db.Uuid
  fromStatus  OrderItemStatus? @map("from_status")
  toStatus    OrderItemStatus  @map("to_status")
  changedById String          @map("changed_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  changedBy User      @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([orderItemId, createdAt])
  @@map("kitchen_events")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  receivedById  String        @map("received_by_id") @db.Uuid
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  amount        Decimal       @db.Decimal(12, 2)
  transactionRef String?      @map("transaction_ref") @db.VarChar(120)
  isRefund      Boolean       @default(false) @map("is_refund")
  paidAt        DateTime      @default(now()) @map("paid_at") @db.Timestamptz(3)
  refundedAt    DateTime?     @map("refunded_at") @db.Timestamptz(3)
  note          String?       @db.VarChar(255)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receivedBy User  @relation(fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([paidAt, method, status])
  @@index([orderId, status])
  @@map("payments")
}

model CashierSession {
  id             String    @id @default(uuid()) @db.Uuid
  openedById     String    @map("opened_by_id") @db.Uuid
  closedById     String?   @map("closed_by_id") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)
  openingBalance Decimal   @map("opening_balance") @db.Decimal(12, 2)
  countedBalance Decimal?  @map("counted_balance") @db.Decimal(12, 2)
  expectedBalance Decimal? @map("expected_balance") @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  status         String    @default("OPEN") @db.VarChar(20)
  
  openedBy       User      @relation("SessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy       User?     @relation("SessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  @@map("cashier_sessions")
}

model DailyReport {
  id                 String   @id @default(uuid()) @db.Uuid
  reportDate         DateTime @unique @map("report_date") @db.Date
  generatedById      String   @map("generated_by_id") @db.Uuid
  totalRevenue       Decimal  @map("total_revenue") @db.Decimal(12, 2)
  cashRevenue        Decimal  @map("cash_revenue") @db.Decimal(12, 2)
  cardRevenue        Decimal  @map("card_revenue") @db.Decimal(12, 2)
  otherRevenue       Decimal  @default(0) @map("other_revenue") @db.Decimal(12, 2)
  complimentaryTotal Decimal  @map("complimentary_total") @db.Decimal(12, 2)
  orderCount         Int      @map("order_count")
  generatedAt        DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  generatedBy User @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@map("daily_reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.Uuid
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SyncHistory {
  id        String   @id @db.Uuid // Matches Outbox.id from SQLite
  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  @@map("sync_history")
}
